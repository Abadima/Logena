{
	"name": "logena",
	"version": "1.1.1",
	"description": "The simplest and fastest logger. Used by Jena, made for you.",
	"keywords": [
		"colors",
		"console",
		"javascript",
		"json",
		"logger",
		"nodejs",
		"simple",
		"string",
		"timestamps"
	],
	"homepage": "https://github.com/abadima/logena#readme",
	"bugs": {
		"url": "https://github.com/abadima/logena/issues"
	},
	"license": "MIT",
	"author": "Abadima",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abadima/logena.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/logger.js",
	"types": "./dist/logger.d.ts",
	"exports": {
		".": {
			"types": "./dist/logger.d.ts",
			"import": "./dist/logger.js",
			"require": "./dist/logger.js"
		}
	},
	"scripts": {
		"beta": "npm publish --tag beta",
		"format": "oxfmt",
		"benchmark": "npm run build && node --expose-gc benchmarks/run.mjs",
		"build": "oxlint --fix && oxfmt && tsc && uglifyjs dist/logger.js -c -m -o dist/logger.js",
		"test": "npm run build && node tests/logger.test.js"
	},
	"devDependencies": {
		"@types/node": "^26.5.0",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"typescript": "^7.0.2",
		"uglify-js": "^3.19.3"
	},
	"engines": {
		"node": ">=14.0.0"
	}
}
